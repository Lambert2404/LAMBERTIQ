# LAMBERTIQ — never commit real keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Microsoft Copilot / Azure OpenAI (OpenAI-compatible chat completions)
MS_COPILOT_API_KEY=
MS_COPILOT_ENDPOINT=https://api.githubcopilot.com/microsoft/v1
MS_COPILOT_MODEL=gpt-4o

# Optional model overrides (provider quotas/models change — keep dynamic)
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
MISTRAL_MODEL=mistral-small-latest
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
CF_MODEL=@cf/meta/llama-3.1-8b-instruct

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Demo seed passwords (change before public deployment)
ADMIN_PASSWORD=admin123
STUDENT_PASSWORD=student123

# Usage limits (configurable in Admin → per-provider daily limits)
FREE_DAILY_LIMIT=20
PREMIUM_DAILY_LIMIT=200
ADMIN_DAILY_LIMIT=1000